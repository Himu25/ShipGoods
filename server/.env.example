# ---- Core (required) ----
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/shipgoods
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-to-a-long-random-string
# Comma-separated frontend origins allowed for REST + Socket.IO. Unset = any (dev only).
CORS_ORIGIN=http://localhost:3001

# Password given to drivers created by an admin
defaultPass=

# Showcase mode: tops every area up to 5 drivers and gives each customer a
# bot driver that accepts their booking and drives to the pickup.
DEMO_MODE=false
DEMO_BOT_SPEED_MPS=10

# ---- Pricing / payments ----
WEATHER_API_KEY=
STRIPE_SECRET_KEY=

# ---- In-app voice agent (fallback when no phone call is possible) ----
GROQ_API_KEY=
GROQ_MODEL=
GOOGLE_MAPS_API_KEY=          # optional; ETA falls back to OSRM (no live traffic)

# ---- Sarvam pickup phone call ----
VOICE_CALLS_ENABLED=false
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_APP_VERSION=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE_NUMBER=
PUBLIC_BASE_URL=https://your-api.example.com   # where Sarvam reaches /api/voice/*
SARVAM_TOOL_SECRET=                            # long random string, also set on the agent's tools
VOICE_TEST_NUMBER=                             # +91XXXXXXXXXX; calls go here unless the customer is in VOICE_ALLOWED_NUMBERS
VOICE_ALLOWED_NUMBERS=                         # comma-separated numbers verified (OTP) in Sarvam; those customers are rung directly

# Trigger tuning (defaults shown)
PICKUP_CALL_ETA_MINUTES=6
PICKUP_CALL_DISTANCE_METERS=2000
PICKUP_CALL_RETRY_AFTER_MS=60000
